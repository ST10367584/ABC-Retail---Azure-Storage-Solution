@using System.IO
@model IEnumerable<ABCRetail.AzureStorage.Services.BlobInfo>

@{
    ViewData["Title"] = "Media Gallery";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header header-media">
    <h1>🖼️ Media Gallery</h1>
    <p>Images stored in <strong>Azure Blob Storage</strong></p>
</div>

<div class="row mb-3">
    <div class="col-md-6">
        <a href="/Media/Upload" class="btn btn-primary">+ Upload Image</a>
    </div>
</div>

@if (TempData["UploadSuccess"] != null)
{
    <div class="alert alert-success">@TempData["UploadSuccess"]</div>
}
@if (TempData["DeleteSuccess"] != null)
{
    <div class="alert alert-success">@TempData["DeleteSuccess"]</div>
}
@if (TempData["DeleteError"] != null)
{
    <div class="alert alert-danger">@TempData["DeleteError"]</div>
}

<div class="row">
    @if (Model != null && Model.Any())
    {
        @foreach (var item in Model)
        {
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3 mb-4">
                <div class="card h-100 gallery-card">
                    <div class="card-img-top text-center bg-light" style="height: 200px; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                        <img src="@item.Url" alt="@item.Name" style="max-height: 180px; max-width: 100%; object-fit: contain;" loading="lazy" />
                    </div>
                    <div class="card-body">
                        <p class="card-text">
                            <small><strong>@System.IO.Path.GetFileName(item.Name)</strong></small><br />
                            <small class="text-muted">Size: @((item.Size / 1024.0).ToString("F1")) KB</small><br />
                            @if (item.LastModified.HasValue)
                            {
                                <small class="text-muted">@item.LastModified.Value.ToString("yyyy-MM-dd HH:mm")</small>
                            }
                        </p>
                    </div>
                    <div class="card-footer">
                        <div class="d-flex gap-1 flex-wrap">
                            <a href="/Media/Download?blobName=@Uri.EscapeDataString(item.Name)" class="btn btn-sm btn-info">Download</a>
                            <form method="post" action="/Media/Delete" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="blobName" value="@item.Name" />
                                <button type="submit" class="btn btn-sm btn-danger"
                                        onclick="return confirm('Delete this image?')">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info text-center">
                <h4>No images found</h4>
                <p>Click "Upload Image" to add your first image.</p>
            </div>
        </div>
    }
</div>