@model ABCRetail.AzureStorage.Models.Customer

@{
    ViewData["Title"] = "Delete Customer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Delete Customer</h1>
<div class="alert alert-danger">
    <h3>Are you sure you want to delete this customer?</h3>
</div>

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-3">Customer ID</dt>
            <dd class="col-sm-9">@Model.CustomerId</dd>

            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@($"{Model.FirstName} {Model.LastName}")</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@Model.Phone</dd>

            <dt class="col-sm-3">Address</dt>
            <dd class="col-sm-9">@Model.Address</dd>

            <dt class="col-sm-3">City</dt>
            <dd class="col-sm-9">@Model.City</dd>

            <dt class="col-sm-3">Postal Code</dt>
            <dd class="col-sm-9">@Model.PostalCode</dd>

            <dt class="col-sm-3">Registered</dt>
            <dd class="col-sm-9">@Model.DateRegistered?.ToString("yyyy-MM-dd")</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="CustomerId" />
            <input type="submit" value="Delete" class="btn btn-danger" />
            <a href="/Customers" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>