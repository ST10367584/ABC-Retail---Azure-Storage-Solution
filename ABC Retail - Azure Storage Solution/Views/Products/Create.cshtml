@model ABCRetail.AzureStorage.Models.Product

@{
    ViewData["Title"] = "Create Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Create Product</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <!-- PRICE INPUT - CHANGED TO RAND (ZAR) -->
            <div class="form-group">
                <label asp-for="Price" class="control-label">Price (ZAR - Rands)</label>
                <div class="input-group">
                    <span class="input-group-text">R</span>
                    <input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01" required value="@Model?.Price.ToString("F2")" />
                </div>
                <span asp-validation-for="Price" class="text-danger"></span>
                <small class="text-muted">Enter the product price in Rands (e.g., 199.99)</small>
            </div>

            <div class="form-group">
                <label asp-for="StockQuantity" class="control-label">Stock Quantity</label>
                <input asp-for="StockQuantity" class="form-control" type="number" min="0" required />
                <span asp-validation-for="StockQuantity" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Category" class="control-label"></label>
                <input asp-for="Category" class="form-control" required />
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label for="imageFile" class="control-label">Product Image</label>
                <input type="file" name="imageFile" class="form-control" accept="image/*" />
                <small class="text-muted">Optional: Upload a product image</small>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Create Product" class="btn btn-primary" />
                <a href="/Products" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>

    <!-- Price Preview Card - CHANGED TO RAND -->
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>💰 Price Preview (ZAR)</h5>
            </div>
            <div class="card-body text-center">
                <div style="font-size: 3rem; color: #2563eb; font-weight: 700;">
                    <span id="pricePreview">R 0.00</span>
                </div>
                <p class="text-muted">Enter a price above to see it formatted</p>
                <div class="alert alert-info">
                    <strong>Format:</strong> South African Rand (ZAR) with 2 decimal places
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h5>Azure Storage Services Used</h5>
            </div>
            <div class="card-body">
                <ul>
                    <li><strong>Azure Table Storage</strong> - Product information including price (ZAR)</li>
                    <li><strong>Azure Blob Storage</strong> - Product images</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Live price preview - CHANGED TO RAND
        document.querySelector('input[name="Price"]').addEventListener('input', function() {
            const price = parseFloat(this.value) || 0;
            document.getElementById('pricePreview').textContent = 'R ' + price.toFixed(2);
        });

        // Trigger initial preview
        const initialPrice = parseFloat(document.querySelector('input[name="Price"]').value) || 0;
        document.getElementById('pricePreview').textContent = 'R ' + initialPrice.toFixed(2);
    </script>
}