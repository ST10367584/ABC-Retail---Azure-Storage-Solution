@model ABCRetail.AzureStorage.Models.Product

@{
    ViewData["Title"] = Model.Name;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isAdmin = User.IsInRole("Admin");
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
}

<div class="container mt-4">
    <a href="/Products" class="btn btn-secondary mb-3">← Back to Products</a>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="card">
        <div class="row g-0">
            <div class="col-12 col-md-5 d-flex align-items-center justify-content-center bg-light" style="min-height: 400px;">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Name"
                         style="max-height: 380px; max-width: 100%; object-fit: contain; padding: 1rem;" />
                }
                else
                {
                    <span class="text-muted" style="font-size: 3rem;">📷</span>
                }
            </div>

            <div class="col-12 col-md-7">
                <div class="card-body p-4">
                    <h1>@Model.Name</h1>

                    <span class="badge bg-secondary mb-3">@Model.Category</span>

                    @if (Model.StockQuantity > 0)
                    {
                        <span class="badge bg-success mb-3">✅ In Stock (@Model.StockQuantity)</span>
                    }
                    else
                    {
                        <span class="badge bg-danger mb-3">❌ Out of Stock</span>
                    }

                    <p class="lead mt-3">@Model.Description</p>

                    <h2 class="text-primary my-4">R @Model.Price.ToString("F2")</h2>

                    <hr />

                    @if (isAdmin)
                    {
                        <div class="d-flex gap-2 flex-wrap">
                            <a href="/Products/Edit/@Model.ProductId" class="btn btn-warning">✏️ Edit</a>
                            <a href="/Products/Delete/@Model.ProductId" class="btn btn-danger">🗑️ Delete</a>
                        </div>
                    }
                    else if (isLoggedIn && Model.StockQuantity > 0)
                    {
                        <div class="d-flex gap-2 flex-wrap">
                            <form method="post" action="/Cart/Add" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@Model.ProductId" />
                                <input type="hidden" name="productName" value="@Model.Name" />
                                <input type="hidden" name="price" value="@Model.Price" />
                                <input type="hidden" name="imageUrl" value="@Model.ImageUrl" />
                                <input type="hidden" name="quantity" value="1" />
                                <button type="submit" class="btn btn-primary btn-lg">🛒 Add to Cart</button>
                            </form>
                            <form method="post" action="/Cart/BuyNow" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@Model.ProductId" />
                                <input type="hidden" name="productName" value="@Model.Name" />
                                <input type="hidden" name="price" value="@Model.Price" />
                                <input type="hidden" name="imageUrl" value="@Model.ImageUrl" />
                                <input type="hidden" name="quantity" value="1" />
                                <button type="submit" class="btn btn-success btn-lg">⚡ Buy Now</button>
                            </form>
                        </div>
                    }
                    else if (!isLoggedIn)
                    {
                        <a href="/Account/Login" class="btn btn-primary btn-lg">🔐 Login to Buy</a>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-lg" disabled>❌ Out of Stock</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>