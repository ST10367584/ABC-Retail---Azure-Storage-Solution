@model IEnumerable<ABCRetail.AzureStorage.Models.Product>

@{
    ViewData["Title"] = "Products";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isAdmin = User.IsInRole("Admin");
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
}

<div class="page-header header-products">
    <h1>🛍️ Products</h1>
    <p>Data stored in <strong>Azure Table Storage</strong> with images in <strong>Azure Blob Storage</strong></p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<!-- Category filter + Search -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <label class="form-label">📂 Category</label>
        <select id="categoryFilter" class="form-select">
            <option value="">All Categories</option>
            @foreach (var cat in new[] { "Phones", "Laptops", "Watches", "Audio", "Tablets", "Accessories" })
            {
                var selected = (ViewBag.Category as string) == cat ? "selected" : "";
                <option value="@cat" selected="@selected">@cat</option>
            }
        </select>
    </div>
    <div class="col-12 col-md-8">
        <label class="form-label">🔍 Search</label>
        <div class="input-group">
            <input type="text" id="pageSearch" class="form-control"
                   value="@ViewBag.Search" placeholder="Search products..." />
            <span class="input-group-text">🔍</span>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <label class="form-label">📂 Category</label>
        <select id="categoryFilter" class="form-select">
            <option value="">All Categories</option>
            @foreach (var cat in new[] { "Phones", "Laptops", "Watches", "Audio", "Tablets", "Accessories" })
            {
                var selected = (ViewBag.Category as string) == cat ? "selected" : "";
                <option value="@cat" selected="@selected">@cat</option>
            }
        </select>
    </div>
    <div class="col-12 col-md-8">
        <label class="form-label">🔍 Search</label>
        <div class="input-group">
            <input type="text" id="pageSearch" class="form-control"
                   value="@ViewBag.Search" placeholder="Search products..." />
            <span class="input-group-text">🔍</span>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    @if (isAdmin)
    {
        <a href="/Products/Create" class="btn btn-primary">+ Create New Product</a>
    }
    else
    {
        <h4 class="text-muted mb-0">🛍️ Browse Products</h4>
    }

    <div class="input-group" style="max-width: 350px;">
        <input type="text" id="productSearch" class="form-control" placeholder="Search products..." />
        <span class="input-group-text">🔍</span>
    </div>
</div>

<div class="row" id="productGrid">
    @if (Model != null && Model.Any())
    {
        @foreach (var item in Model)
        {
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3 mb-4 product-item">
                <div class="card h-100 product-card animate-on-scroll">
                    <div class="card-img-top text-center bg-light" style="height: 200px; display: flex; align-items: center; justify-content: center;">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.Name" style="max-height: 180px; max-width: 100%; object-fit: contain;" loading="lazy" />
                        }
                        else
                        {
                            <span class="text-muted">📷 No Image</span>
                        }
                    </div>

                    <div class="card-body">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text text-muted" style="font-size: 0.9rem;">@item.Description</p>

                        <div class="price-display mb-2">
                            <span class="price">R @item.Price.ToString("F2")</span>
                            @if (item.StockQuantity > 0)
                            {
                                <span class="badge bg-success">In Stock</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Out of Stock</span>
                            }
                        </div>

                        <small class="text-muted">
                            <strong>Stock:</strong> @item.StockQuantity |
                            <strong>Category:</strong> @item.Category
                        </small>
                    </div>

                    <div class="card-footer">
                        @if (isAdmin)
                        {
                            <div class="d-flex gap-1 flex-wrap">
                                <a href="/Products/Details/@item.ProductId" class="btn btn-sm btn-info w-100 mt-1">👁️ View Details</a>
                                <a href="/Products/Edit/@item.ProductId" class="btn btn-sm btn-warning">✏️ Edit</a>
                                <a href="/Products/Delete/@item.ProductId" class="btn btn-sm btn-danger">🗑️ Delete</a>
                                <a href="/Products/Details/@item.ProductId" class="btn btn-sm btn-info">👁️ View</a>
                            </div>
                        }
                        else if (isLoggedIn && item.StockQuantity > 0)
                        {
                            <div class="d-flex flex-column gap-2">
                                <div class="d-flex gap-1">
                                    <form method="post" action="/Cart/Add" style="display:inline; flex:1;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <input type="hidden" name="productName" value="@item.Name" />
                                        <input type="hidden" name="price" value="@item.Price" />
                                        <input type="hidden" name="imageUrl" value="@item.ImageUrl" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="btn btn-sm btn-primary w-100">🛒 Add to Cart</button>
                                    </form>
                                    <form method="post" action="/Cart/BuyNow" style="display:inline; flex:1;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <input type="hidden" name="productName" value="@item.Name" />
                                        <input type="hidden" name="price" value="@item.Price" />
                                        <input type="hidden" name="imageUrl" value="@item.ImageUrl" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="btn btn-sm btn-success w-100">⚡ Buy Now</button>
                                    </form>
                                </div>
                                <a href="/Products/Details/@item.ProductId" class="btn btn-sm btn-outline-secondary w-100">👁️ View Details</a>
                            </div>
                        }
                        else if (isLoggedIn && item.StockQuantity == 0)
                        {
                            <div class="d-flex flex-column gap-2">
                                <button class="btn btn-sm btn-secondary w-100" disabled>❌ Out of Stock</button>
                                <a href="/Products/Details/@item.ProductId" class="btn btn-sm btn-outline-secondary w-100">👁️ View Details</a>
                            </div>
                        }
                        else if (!isLoggedIn)
                        {
                            <div class="d-flex flex-column gap-2">
                                <a href="/Account/Login" class="btn btn-sm btn-primary w-100">🔐 Login to Buy</a>
                                <a href="/Products/Details/@item.ProductId" class="btn btn-sm btn-outline-secondary w-100">👁️ View Details</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info text-center">
                <h4>No products found</h4>
                @if (isAdmin)
                {
                    <p>Click "Create New Product" to add your first product.</p>
                }
                else
                {
                    <p>Please check back later for new products.</p>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.getElementById('productSearch')?.addEventListener('input', function (e) {
            const term = e.target.value.toLowerCase();
            document.querySelectorAll('.product-item').forEach(item => {
                const text = item.textContent.toLowerCase();
                item.style.display = text.includes(term) ? '' : 'none';
            });
        });


               // Category filter
        document.getElementById('categoryFilter')?.addEventListener('change', function () {
            const cat = this.value;
            const search = document.getElementById('pageSearch')?.value || '';
            const params = new URLSearchParams();
            if (cat) params.set('category', cat);
            if (search) params.set('search', search);
            window.location.href = '/Products' + (params.toString() ? '?' + params.toString() : '');
        });

        // Search on Enter
        document.getElementById('pageSearch')?.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                const cat = document.getElementById('categoryFilter')?.value || '';
                const params = new URLSearchParams();
                if (cat) params.set('category', cat);
                if (this.value) params.set('search', this.value);
                window.location.href = '/Products' + (params.toString() ? '?' + params.toString() : '');
            }
        });
    </script>
}