@model List<ABCRetail.AzureStorage.Models.OrderMessage>

@{
    ViewData["Title"] = "Order History";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <h1>📦 Order History</h1>
    <p>All your past orders</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-sm-4">
        <div class="stat-card blue">
            <h6>Total Orders</h6>
            <h3>@Model.Count</h3>
        </div>
    </div>
    <div class="col-12 col-sm-4">
        <div class="stat-card green">
            <h6>Total Spent</h6>
            <h3>R @Model.Sum(o => o.TotalAmount).ToString("F2")</h3>
        </div>
    </div>
    <div class="col-12 col-sm-4">
        <div class="stat-card orange">
            <h6>Average Order</h6>
            <h3>R @(Model.Any() ? Model.Average(o => o.TotalAmount).ToString("F2") : "0.00")</h3>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Date</th>
                            <th>Items</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Shipping</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.OrderByDescending(o => o.OrderDate))
                        {
                            <tr>
                                <td><code>@(order.OrderId?.Length > 8 ? order.OrderId.Substring(0, 8) : order.OrderId)</code></td>
                                <td>@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@order.Items.Count</td>
                                <td><strong>R @order.TotalAmount.ToString("F2")</strong></td>
                                <td><span class="badge bg-warning">@order.Status</span></td>
                                <td class="small text-muted">@order.ShippingAddress</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div style="font-size: 3rem;">📦</div>
                <h5>No order history yet</h5>
                <a href="/Products" class="btn btn-primary mt-2">Start Shopping</a>
            </div>
        }
    </div>
</div>